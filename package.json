{
	"name": "@rolarie/sdk",
	"version": "0.31.0",
	"description": "Build games for Rolarie: how a game's outcomes are made into books, the client's bridge to the site, the stage, the control bar and controls, Storybook, the site's own checks, and rolarie-studio, the command line to make a game's books, check it and play it. Clone it to start a studio.",
	"license": "MIT",
	"type": "module",
	"private": true,
	"//": "Private so that it is never published to a registry: a studio clones this repository, and the site takes it at a git tag.",
	"bin": {
		"rolarie-studio": "./src/cli.ts"
	},
	"exports": {
		"./maths": "./src/maths.ts",
		"./guide": "./src/guide.ts",
		"./events": "./src/events.ts",
		"./manifest": "./src/manifest.ts",
		"./studio-folder": "./src/studio-folder.ts",
		"./rng": "./src/rng.ts",
		"./limits": "./src/limits.ts",
		"./bets": "./src/bets.ts",
		"./book": "./src/book.ts",
		"./book-check": "./src/book-check.ts",
		"./book-files": "./src/book-files.ts",
		"./book-game": "./src/book-game.ts",
		"./book-maker": "./src/book-maker.ts",
		"./book-play": "./src/book-play.ts",
		"./book-report": "./src/book-report.ts",
		"./book-round": "./src/book-round.ts",
		"./book-weights": "./src/book-weights.ts",
		"./game-manifest": "./src/game-manifest.ts",
		"./coins": "./src/coins.ts",
		"./slots": "./src/slots.ts",
		"./stake-steps": "./src/stake-steps.ts",
		"./stories": "./src/stories.ts",
		"./story": "./src/StoryFrame.svelte",
		"./page": "./src/GamePage.svelte",
		"./labels": "./src/labels.ts",
		"./pixi": "./src/pixi/index.ts",
		"./slot": "./src/slot/index.ts",
		"./emitter": "./src/emitter.svelte.ts",
		"./views": "./src/views.ts",
		"./shapes": "./src/shapes.ts",
		"./protocol": "./src/protocol.ts",
		"./host": "./src/host.ts",
		"./frame": "./src/frame.ts",
		"./client": "./src/client.ts",
		"./ui": "./src/ui.ts",
		"./bar": "./src/bar.ts",
		"./bar-rules": "./src/bar-rules.ts",
		"./loading": "./src/loading.ts",
		"./loading-look": "./src/loading-look.ts",
		"./client-build": "./src/client-build.ts",
		"./client-record": "./src/client-record.ts",
		"./release-pack": "./src/release-pack.ts",
		"./game-package": "./src/game-package.ts",
		"./counter-conversion": "./src/counter-conversion.ts",
		"./tar": "./src/tar.ts",
		"./cli-path": "./src/cli-path.ts",
		"./controls": "./src/controls/index.ts",
		"./testing": "./src/testing.ts",
		"./verify": "./src/verify.ts",
		"./stand-in": "./src/stand-in.ts",
		"./ui.css": "./src/ui.css",
		"./bar.css": "./src/bar.css",
		"./loading.css": "./src/loading.css"
	},
	"imports": {
		"#engine/*": {
			"rolarie-dev": "./local/engine/src/*.ts",
			"default": "@rolarie/engine/*"
		},
		"#engine/Views.svelte": {
			"rolarie-dev": "./local/engine/src/Views.svelte",
			"default": "@rolarie/engine/Views.svelte"
		},
		"#engine/GameFrame.svelte": {
			"rolarie-dev": "./local/engine/src/GameFrame.svelte",
			"default": "@rolarie/engine/GameFrame.svelte"
		}
	},
	"scripts": {
		"books": "bun src/cli.ts books --root src/test/book-studio",
		"client": "bun src/cli.ts client reel-test --root src/test/book-studio",
		"check": "bun src/cli.ts check reel-test --root src/test/book-studio",
		"dev": "bun src/cli.ts dev reel-test --root src/test/book-studio",
		"stories": "bun src/cli.ts stories --root src/test/book-studio",
		"test": "bun node_modules/vitest/vitest.mjs --run",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"typecheck:local": "svelte-check --tsconfig ./tsconfig.local.json",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test:browser": "bun node_modules/@playwright/test/cli.js install chromium && bun node_modules/@playwright/test/cli.js test",
		"local": "ROLARIE_DEV=1 BUN_OPTIONS=--conditions=rolarie-dev NODE_OPTIONS=--conditions=rolarie-dev bun run"
	},
	"dependencies": {
		"@rolarie/engine": "github:Rolarie/engine#v0.12.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@noble/hashes": "^2.4.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.4.0",
		"@storybook/svelte-vite": "^10.6.7",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"pixi.js": "^8.23.0",
		"storybook": "^10.6.7"
	},
	"peerDependencies": {
		"svelte": "^5.57.2",
		"valibot": "^1.5.0",
		"vite": "^8.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@types/bun": "^1.4.4",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"playwright": "^1.60.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"valibot": "^1.5.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	}
}
